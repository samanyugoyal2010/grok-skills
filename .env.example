# stdio is the default. Set MCP_TRANSPORT=http for a stateless HTTP endpoint.
MCP_TRANSPORT=stdio
PORT=3000
MCP_HTTP_HOST=127.0.0.1
# Required when MCP_HTTP_HOST is not loopback. Also protects loopback when set.
MCP_HTTP_AUTH_TOKEN=
# Optional comma-separated browser origins allowed to reach /mcp.
MCP_HTTP_ALLOWED_ORIGINS=
# Required for non-loopback HTTP binds. Comma-separated hostnames, without ports.
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_MAX_BODY_BYTES=256000
# Optional trusted reverse-proxy header used as the rate-limit client identity.
# Set only when the proxy overwrites this header; direct clients can spoof it.
MCP_HTTP_CLIENT_ID_HEADER=

# Optional model-backed compiler. Without a provider or custom endpoint, the deterministic local compiler is used.
# Cloud provider API keys are read only by the local MCP server process, never compile_skill arguments or prompt content.
# Ollama requires no API key and uses an already-installed local model; SkillChef never pulls models.
# Set SKILL_COMPILER_PROVIDER if more than one cloud provider key is configured; with one key it is inferred.
SKILL_COMPILER_PROVIDER=
SKILL_COMPILER_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# For Ollama: SKILL_COMPILER_PROVIDER=ollama, SKILL_COMPILER_MODEL=qwen3:8b
# Optional; restricted to HTTP loopback hosts to keep approved context on this machine.
SKILL_COMPILER_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional custom JSON-compatible endpoint (legacy). Mutually exclusive with provider keys.
SKILL_COMPILER_MODEL_URL=
SKILL_COMPILER_MODEL_TOKEN=
SKILL_COMPILER_MODEL_TIMEOUT_MS=20000
# Development-only escape hatch for a non-loopback HTTP model endpoint.
SKILL_COMPILER_ALLOW_INSECURE_HTTP=false
SKILL_COMPILER_DEADLINE_MS=60000
MAX_IN_FLIGHT_COMPILATIONS=2

# Comma-separated public GitHub skill repositories used by the first adapter. Empty disables retrieval.
PUBLIC_SKILL_REPOSITORIES=vercel-labs/agent-skills,anthropics/skills
PUBLIC_SKILL_BRANCH=main
PUBLIC_SKILL_FETCH_TIMEOUT_MS=10000
# Optional GitHub token for higher public API limits. Never commit this value.
PUBLIC_SKILL_GITHUB_TOKEN=

# HTTP requests per client address per minute; stdio uses one local process bucket.
RATE_LIMIT_PER_MINUTE=10
# Maximum number of client-address buckets retained by the in-memory limiter.
RATE_LIMIT_MAX_KEYS=10000
