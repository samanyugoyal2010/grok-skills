# stdio is the default. Set MCP_TRANSPORT=http for a stateless HTTP endpoint.
MCP_TRANSPORT=stdio
PORT=3000
MCP_HTTP_HOST=127.0.0.1
# Required when MCP_HTTP_HOST is not loopback. Also protects loopback when set.
MCP_HTTP_AUTH_TOKEN=
# Optional comma-separated browser origins allowed to reach /mcp.
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_ALLOWED_HOSTS=
MCP_HTTP_MAX_BODY_BYTES=256000

# Optional hosted compiler endpoint. Without this, the deterministic local compiler is used.
SKILL_COMPILER_MODEL_URL=
SKILL_COMPILER_MODEL_TOKEN=
SKILL_COMPILER_MODEL_TIMEOUT_MS=20000

# Comma-separated public GitHub skill repositories used by the first adapter.
PUBLIC_SKILL_REPOSITORIES=vercel-labs/agent-skills,anthropics/skills
PUBLIC_SKILL_BRANCH=main
PUBLIC_SKILL_FETCH_TIMEOUT_MS=10000

# Anonymous per-process limit. This is intentionally coarse for v1.
RATE_LIMIT_PER_MINUTE=10
